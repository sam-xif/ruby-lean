.env
.venv/
__pycache__/
.hypothesis/
reports/
*.egg-info/

# Harvested Homebrew-slice corpus (W4a). Generated, not vendored: each program
# embeds ~20 KB of upstream Homebrew, so 355 of them is ~7 MB of someone else's
# code. Rebuild with `python -m difftest harvest-rspec --brew <path>`.
corpus/homebrew-slice/

# Generated domain-input corpus (W4d); rebuild with `difftest domain-fuzz`.
corpus/domain-fuzz/

# Advisory-shape corpus (R1). Generated, not vendored, for the same reason as
# the two above: each program embeds the linked slice.
# Rebuild with `python -m difftest advisory-fuzz --brew <path>`.
corpus/advisory-fuzz/
