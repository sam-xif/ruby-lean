def unicodePrintable (c : Char) : Bool :=
  if c.toNat < 128 then 32 ≤ c.toNat && c.toNat < 127 else
  !nonprintRanges.any (fun (lo, hi) => lo ≤ c.toNat && c.toNat ≤ hi)

