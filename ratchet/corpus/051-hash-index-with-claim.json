{
  "id": "hash-index-with-claim",
  "tier": 5,
  "description": "Hash indexing is also just `#[]`. An explicit claim supplies its type -- the only way to do this precisely at all, since Ty has no parameterised Hash type (see hash-lit) to derive it from the receiver structurally.",
  "program": {
    "v": 5,
    "ast": [
      "send",
      [
        "hash",
        [
          [
            [
              "str",
              "a"
            ],
            [
              "int",
              1
            ]
          ]
        ]
      ],
      "[]",
      [
        [
          "str",
          "a"
        ]
      ],
      null
    ]
  },
  "cert": {
    "claims": [
      {
        "expr": [
          "send",
          [
            "hash",
            [
              [
                [
                  "str",
                  "a"
                ],
                [
                  "int",
                  1
                ]
              ]
            ]
          ],
          "[]",
          [
            [
              "str",
              "a"
            ]
          ],
          null
        ],
        "ty": {
          "tag": "int"
        }
      }
    ]
  },
  "expect_validate": true,
  "false_reason": null
}
